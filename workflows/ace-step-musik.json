{
  "_studio": {
    "kind": "audio",
    "label": "ACE-Step lokal - GRATIS (musik instrumental)",
    "note": "Musik latar dari deskripsi gaya (tags). Jalan di GPU sendiri. Butuh ace_step_v1_3.5b.safetensors (~7.7 GB) di models/checkpoints. Belum diuji dengan ComfyUI asli.",
    "max_duration": 240,
    "timeout": 1800,
    "models": [
      {"folder": "checkpoints", "file": "ace_step_v1_3.5b.safetensors", "gb": 7.7, "url": "https://huggingface.co/Comfy-Org/ACE-Step_ComfyUI_repackaged/resolve/main/all_in_one/ace_step_v1_3.5b.safetensors"}
    ]
  },
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ace_step_v1_3.5b.safetensors"}},
  "2": {"class_type": "TextEncodeAceStepAudio", "inputs": {"clip": ["1", 1], "tags": "{{PROMPT}}", "lyrics": "[instrumental]", "lyrics_strength": 0.99}},
  "3": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["2", 0]}},
  "4": {"class_type": "EmptyAceStepLatentAudio", "inputs": {"seconds": "{{DURATION}}", "batch_size": 1}},
  "5": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 5}},
  "6": {"class_type": "KSampler", "inputs": {"model": ["5", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0], "seed": "{{SEED}}", "steps": 50, "cfg": 5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1}},
  "7": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["6", 0], "vae": ["1", 2]}},
  "8": {"class_type": "SaveAudio", "inputs": {"audio": ["7", 0], "filename_prefix": "audio/studio_music"}}
}
